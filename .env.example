# PostgreSQL bağlantı adresi
# Yerel:  postgres://kullanici:sifre@localhost:5432/ecommerce_web
# Canlı (Neon/Supabase/Railway vb.): sağlayıcının verdiği adres, gerekirse sonuna ?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecommerce_web

# İlk yönetici hesabı (bun run db:seed ile oluşturulur, sonra panelden şifreyi değiştirin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=degistir-beni-123

# Sitenin canlı adresi (WhatsApp mesajlarındaki ürün linkleri için)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
